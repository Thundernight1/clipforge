# Ollama Cloud — https://ollama.com/settings/keys
OLLAMA_API_KEY=
OLLAMA_HOST=https://ollama.com
# Must match `ollama ls` cloud names (with :cloud suffix)
# Default: kimi-k3:cloud
# Alts: kimi-k2.6:cloud | kimi-k2.7-code:cloud | minimax-m3:cloud | deepseek-v4-flash:cloud | glm-5.3:cloud
OLLAMA_MODEL=kimi-k3:cloud
